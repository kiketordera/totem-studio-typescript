{
  "name": "@totemstudioai/sdk",
  "version": "0.2.0-beta.1",
  "description": "Official server-side TypeScript SDK for the Totem Studio public API (Beta)",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Totem Studio",
    "email": "hello@totemstudio.ai"
  },
  "homepage": "https://totemstudio.ai/developers",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 tests/*.test.mjs",
    "test:file": "npm run build && node --test --test-concurrency=1 --test-timeout=30000",
    "test:consumer": "node scripts/test-consumer.mjs",
    "test:git-install": "node scripts/test-git-install.mjs",
    "pretest:live": "npm run build",
    "test:live": "node scripts/live-smoke.mjs",
    "health": "npm run generate:check && npm run typecheck && npm test && npm run test:consumer",
    "prepublishOnly": "npm run health",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiketordera/totem-studio-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/kiketordera/totem-studio-typescript/issues"
  }
}
